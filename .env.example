# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored, so your secrets never get committed.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragdb

# Hostname the API/ingestion containers use to reach the database.
# Inside docker-compose's network, containers reach each other by
# service name, so this should be "postgres" (the service name below),
# NOT "localhost".
DB_HOST=postgres
DB_PORT=5432

# --- LLM provider ---
GROQ_API_KEY=your_groq_api_key_here
